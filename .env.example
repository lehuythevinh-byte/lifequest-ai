# Gemini API key: local development only. On Render, set GEMINI_API_KEY in the service Environment tab.
# Never expose this key in frontend code or commit a real key to Git.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional public URL of the deployed Render web service.
APP_URL="https://YOUR-SERVICE.onrender.com"

# Optional model identifier. gemini-3.8-flash is listed in the current Gemini API model catalog.
GEMINI_MODEL="gemini-3.8-flash"

# Optional account system (required for User/Admin features). Use a persistent PostgreSQL database.
# On Render, create a PostgreSQL database and set its internal connection string as DATABASE_URL.
DATABASE_URL=
# Set these only to bootstrap the initial administrator account. Use a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
# Set PGSSLMODE=require only if your PostgreSQL provider requires TLS.
PGSSLMODE=
