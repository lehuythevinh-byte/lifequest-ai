)=>{g.fillStyle=col;if(headPhase){const left=Math.round(64+(x-64)*headScale+headOffset),right=Math.round(64+(x+w-64)*headScale+headOffset);g.fillRect(left,Math.round(y),Math.max(1,right-left),Math.round(h));}else g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h));};"," // Scanline polygons produce crisp pixel clusters without antialiasing."," const p=(pts,col)=>{let ys=pts.map(t=>t[1]);for(let y=Math.min(...ys);y<Math.max(...ys);y++){const xs=[];for(let i=0,j=pts.length-1;i<pts.length;j=i++){let [a,b]=pts[j],[d,e]=pts[i];if((b<=y+.5&&e>y+.5)||(e<=y+.5&&b>y+.5))xs.push(a+(y+.5-b)*(d-a)/(e-b));}xs.sort((a,b)=>a-b);for(let i=0;i+1<xs.length;i+=2)r(Math.ceil(xs[i]),y,Math.ceil(xs[i+1])-Math.ceil(xs[i]),1,col);}};"," const line=(x,y,X,Y,col,w=1)=>{let dx=Math.abs(X-x),sx=x<X?1:-1,dy=-Math.abs(Y-y),sy=y<Y?1:-1,err=dx+dy;for(;;){r(x,y,w,w,col);if(x===X&&y===Y)break;let z=2*err;if(z>=dy){err+=dy;x+=sx}if(z<=dx){err+=dx;y+=sy}}};"," const oval=(x,y,rx,ry,col)=>{for(let j=-ry;j<=ry;j++){let d=Math.floor(rx*Math.sqrt(Math.max(0,1-j*j/ry/ry)));r(x-d,y+j,d*2+1,1,col);}};"," const long=['long','longbun','highpony','flare'].includes(look.style), bun=['bun','longbun','highpony'].includes(look.style), bald=look.style==='bald';"," // Rear hair silhouette, then shoulders, tailored clothing and neck."," if(long){p([[31,34],[39,18],[83,17],[99,34],[100,86],[106,108],[85,119],[43,115],[23,106],[30,81]],ink);p([[35,32],[43,21],[81,22],[95,38],[96,83],[102,105],[86,112],[39,109],[28,103],[34,80]],HD);p([[35,49],[41,48],[42,97],[35,106],[30,102]],H);p([[88,43],[94,43],[93,86],[99,104],[90,108]],H);}"," if(bun){oval(68,17,18,13,ink);oval(68,17,15,10,H);p([[54,13],[62,8],[76,10],[78,14],[66,12]],HL);}"," p([[12,128],[14,112],[23,104],[42,96],[49,85],[79,85],[86,96],[105,104],[114,112],[116,128]],ink);"," p([[16,128],[18,113],[27,107],[48,99],[80,99],[101,107],[110,114],[112,128]],C);"," p([[16,128],[18,113],[30,106],[45,102],[40,109],[34,115],[30,128]],CL);p([[88,103],[102,10